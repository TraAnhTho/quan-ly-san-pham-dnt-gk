# Sao chép file này thành .env. Không nhập mật khẩu tài khoản, token hoặc service-account key.
# Để trống Firebase config: app tự vào chế độ demo. Có thể ép demo bằng true.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Chỉ bật true sau khi đã tạo bucket, kiểm tra billing và triển khai Storage Rules.
EXPO_PUBLIC_ENABLE_STORAGE=false
